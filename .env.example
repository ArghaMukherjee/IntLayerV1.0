# Copy to .env and change every value before running `docker compose up`.
# Use letters and digits only in passwords (they are embedded in connection URLs).

POSTGRES_PASSWORD=change_me_postgres
IL_API_DB_PASSWORD=change_me_il
APP2_DB_PASSWORD=change_me_app2
SCHEDULER_DB_PASSWORD=change_me_scheduler
BI_READER_DB_PASSWORD=change_me_bi
UI_READER_DB_PASSWORD=change_me_ui

# API key App1 sends in the X-API-Key header, and the admin key for /v1/admin/*
APP1_API_KEY=app1-dev-key
ADMIN_API_KEY=admin-dev-key

# Shared secret used to sign callbacks (X-IL-Signature); App1 verifies it
CALLBACK_SIGNING_SECRET=change_me_callback_secret

# Hosts allowed in callback_url (comma-separated; empty = any)
CALLBACK_ALLOWED_HOSTS=app1-mock
